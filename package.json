    "verify:slice2:public": "node scripts/verify-slice2-public.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "playwright": "^1.62.1",
    "typescript": "6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
