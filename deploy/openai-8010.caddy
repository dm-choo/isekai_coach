# Shared origin for openai.ktwome.cc. The submission owns the root fallback,
# while /slice1/ and /slice2/ remain isolated regression scenes.
http://:8010 {
	bind 127.0.0.1
	encode zstd gzip

	handle_path /slice2/* {
		root * /srv/ooh/current/slice2
		try_files {path} /index.html
		file_server
	}

	handle_path /slice1/* {
		root * /srv/ooh/current/slice1
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/ooh/current
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	@html path / /index.html /slice1 /slice1/ /slice1/index.html /slice2 /slice2/ /slice2/index.html
	header @html Cache-Control "no-cache, no-transform"
}
