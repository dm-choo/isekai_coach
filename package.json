{
  "name": "isekai-coach-combat-scaffold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:slice": "VITE_SLICE=1 npm run build -- --base /slice1/",
    "build:slice2": "VITE_SLICE=2 npm run build",
    "build:submission": "VITE_SLICE=submission npm run build -- --base /",
    "deploy:setup": "sudo ./deploy/install-passwordless-deploy.sh",
    "deploy:slice1": "npm run build:slice && sudo -n /usr/local/sbin/isekai-coach-deploy slice1 && ./deploy/verify-slice1.sh",
    "deploy:slice2": "npm run build:slice2 && sudo -n /usr/local/sbin/isekai-coach-deploy slice2 && ./deploy/verify-slice2.sh && npm run verify:slice2:public",
    "deploy:submission": "npm run build:submission && sudo -n /usr/local/sbin/isekai-coach-deploy submission && ./deploy/verify-submission.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:combat-ux": "node scripts/verify-combat-ux.mjs",
    "verify:slice2": "node scripts/verify-slice2.mjs",
    "verify:slice2:public": "node scripts/verify-slice2-public.mjs",
    "verify:submission:interaction": "node scripts/verify-submission-interaction.mjs",
    "verify:submission:solo-combat": "node scripts/verify-submission-solo-combat.mjs",
    "verify:submission:normal-combat": "node scripts/verify-submission-normal-combat.mjs",
    "verify:submission:ally-policy": "node scripts/verify-submission-ally-policy.mjs",
    "verify:submission:encounter-transition": "node scripts/verify-submission-encounter-transition.mjs",
    "verify:submission:failure": "node scripts/verify-submission-failure.mjs",
    "verify:submission:public": "node scripts/verify-submission-public.mjs",
    "verify:submission:p2": "node scripts/submission-golden-driver.mjs",
    "verify:submission:p3": "SUBMISSION_VERIFY_STAGE=P3 node scripts/submission-golden-driver.mjs",
    "verify:submission:p4": "SUBMISSION_VERIFY_STAGE=P4 node scripts/submission-golden-driver.mjs",
    "verify:submission:golden": "SUBMISSION_VERIFY_STAGE=P5 node scripts/verify-submission-golden.mjs",
    "verify:submission-rc": "node scripts/verify-submission-rc.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "playwright": "^1.62.1",
    "typescript": "6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
